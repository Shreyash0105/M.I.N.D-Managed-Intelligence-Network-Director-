
MONGODB_URI=mongo-uri-link-goes-here
MONGODB_DB=trans
JWT_SECRET=your-secret-goes-here
JWT_EXPIRE_MINUTES=720

# gemini | fake  (fake = no API key needed, canned answers, good for offline demo/tests)
LLM_PROVIDER=gemini
LLM_API_KEY=LLM_API_KEY
# Check Google's current model list and change if needed
LLM_MODEL_MAIN=gemini-3.5-flash
LLM_MODEL_FAST=gemini-3.5-flash-lite
# 0 turns off "thinking" for 2.5 flash models (faster, cheaper). Use -1 to not send the setting.
LLM_THINKING_BUDGET=0

# local = sentence-transformers MiniLM | hash = tiny offline fallback (weaker meaning match)
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMS=384

WORTHINESS_THRESHOLD=0.6
SIMILARITY_THRESHOLD=0.45
MIN_SEMANTIC=0.25
# LLM reranker on the top results (costs one extra LLM call per chat turn)
RERANK_ENABLED=false
STALE_DAYS=14
DECAY_HALF_LIFE_DAYS=60
ARCHIVE_THRESHOLD=0.12
REFLECTION_MIN_GROUP=3
RATE_LIMIT_PER_MIN=30
CORS_ORIGINS=http://localhost:5173

# ---- LangGraph ----
# true = the four LangGraph workflows; false = the old plain-function pipeline (agents/orchestrator.py) as a safety net
USE_LANGGRAPH=true
# mongo = MongoDBSaver in your Atlas cluster | memory = no persistence (only for experiments)
GRAPH_CHECKPOINTER=mongo
# loops need more than LangGraph's default of 25 steps
GRAPH_RECURSION_LIMIT=100
# the Learn graph handles at most this many memories per chat turn
LEARN_MAX_CANDIDATES=5
# below this judge confidence the Learn graph pauses and asks a human (Decision inbox)
JUDGE_CONFIDENCE_MIN=0.6
# finished graph threads older than this are purged by the Freshness graph (paused ones are kept)
THREAD_RETENTION_DAYS=7
# true = the Reflection graph asks a human before it saves a lesson
REFLECTION_REQUIRE_APPROVAL=false
# demo helper (also a switch in Settings): always ask a human when the judge says "contradicts"
DEMO_ASK_ON_CONFLICT=false
